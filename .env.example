# Any OpenAI-compatible endpoint that serves the frontier model
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4.1-flash
# Optional: a llama.cpp server with the small model + the trained adapter (see README). Without it the page
# shows the small model's recorded benchmark answers.
SMALL_URL=http://127.0.0.1:8081
# Cost control for the public demo
DAILY_BUDGET_USD=0.50
PER_VISITOR_PER_DAY=30
